# CHZZK Developer Center에서 발급한 값
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=

# 개발 PC에서 그대로 사용: http://localhost:3000/auth/callback
CHZZK_REDIRECT_URI=http://localhost:3000/auth/callback

# 선택사항: AI 사건 생성. 비워두면 로컬 규칙 기반 생성기가 사용됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
